-- [[ MULTI-SCRIPT LOADER HUB (ORION UI VERSION) ]] --
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()

-- 1. ตั้งค่าระบบเสียง
local SoundID = "rbxassetid://140207837688369"

local function PlayClickSound()
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = SoundID
        sound.Volume = 1
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        sound.Ended:Wait()
        sound:Destroy()
    end)
end

-- 2. สร้างหน้าต่าง Orion UI
local Window = OrionLib:CreateWindow({
    Name = "⚡ LOADER HUB | Fadel-99",
    HidePremium = false,
    SaveConfig = false,
    ConfigFolder = "FadelHubConfig",
    IntroEnabled = true,
    IntroText = "by Dell"
})

-- สร้าง 2 แท็บหลัก
local Tab1 = Window:MakeTab({
    Name = "🌲 99วันในป่า",
    Icon = "rbxassetid://4483362458",
    PremiumOnly = false
})

local Tab2 = Window:MakeTab({
    Name = "⌨️ คีย์บอร์ด",
    Icon = "rbxassetid://4483362458",
    PremiumOnly = false
})

local Plr = game.Players.LocalPlayer

-- ==================== [ TAB 1: 99วันในป่า ] ==================== --
Tab1:AddSection({
    Name = "🚀 สคริปต์ 99วันในป่า (You a kill)"
})

Tab1:AddButton({
    Name = "▶️ กดเพื่อรันสคริปต์ (99วันในป่า)",
    Callback = function()
        PlayClickSound()
        OrionLib:MakeNotification({
            Name = "Executing...",
            Content = "กำลังโหลดสคริปต์ 99วันในป่า...",
            Image = "rbxassetid://4483362458",
            Time = 3
        })
        loadstring(game:HttpGet("https://raw.githubusercontent.com/ggdd49272-eng/You-a-roblox/refs/heads/main/You%20a%20kill"))()
    end    
})

Tab1:AddButton({
    Name = "📋 คัดลอกลิงก์ Discord",
    Callback = function()
        PlayClickSound()
        setclipboard("https://discord.gg/MWgJa5fRJ")
        OrionLib:MakeNotification({
