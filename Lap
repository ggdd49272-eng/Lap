            Time = 3
        })
    end    
})

-- ==================== [ TAB 2: คีย์บอร์ด ] ==================== --
Tab2:AddSection({
    Name = "🚀 สคริปต์แมพคีย์บอร์ด (Luarmor Loader)"
})

