    Callback = function()
        PlayClickSound()
        OrionLib:MakeNotification({
            Name = "Executing...",
            Content = "กำลังโหลดสคริปต์คีย์บอร์ด...",
            Image = "rbxassetid://4483362458",
            Time = 3
        })
        loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/359e97f8618e9008afe5f496184ebb7c.lua"))()
    end    
})

Tab2:AddSection({
    Name = "⚡ ปรับแต่งตัวละคร (Player Settings)"
})

Tab2:AddSlider({
    Name = "ความเร็วการเดิน (WalkSpeed)",
    Min = 16,
    Max = 200,
    Default = 16,
    Color = Color3.fromRGB(255, 255, 255),
    Increment = 1,
    ValueName = "Speed",
    Callback = function(Value)
        if Plr.Character and Plr.Character:FindFirstChild("Humanoid") then
            Plr.Character.Humanoid.WalkSpeed = Value
        end
    end    
})

Tab2:AddSlider({
    Name = "แรงกระโดด (JumpPower)",
    Min = 50,
    Max = 300,
    Default = 50,
    Color = Color3.fromRGB(255, 255, 255),
    Increment = 5,
    ValueName = "Jump",
    Callback = function(Value)
        if Plr.Character and Plr.Character:FindFirstChild("Humanoid") then
